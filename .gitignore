# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.test-build

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local editor and assistant state
*.code-workspace
/.idea/
/.codex/
/.agents/

# Credentials and local certificates
*.key
*.p12
*.pfx
*.keystore
.npmrc
.netrc

# Local databases, exports and backups
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.dump
*.bak
*.backup
*.log
/backups/
/dumps/
